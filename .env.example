# Referencia local. server.py no carga este archivo automáticamente.
WHITE_HOST=127.0.0.1
WHITE_PORT=8000
WHITESOFT_DATA=./data

# Configurá las contraseñas en el entorno seguro antes del primer arranque.
# Para acceso fuera de localhost se requieren:
# WHITE_ADMIN_PASSWORD
# WHITE_DISPATCHER_PASSWORD
# WHITE_COURIER_PASSWORD
# WHITE_COOKIE_SECURE=1
# WHITE_ALLOW_INSECURE_LAN=1 solo permite una prueba HTTP en Wi-Fi privado.
